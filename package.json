{
  "type": "module",
  "name": "zalo-multi-bridge",
  "version": "1.0.0",
  "description": "Multi-account Zalo bridge — manage multiple Zalo accounts simultaneously via zca-js. HTTP API + CLI. One process, all accounts.",
  "main": "server.js",
  "bin": {
    "zalo-multi": "./cli.js"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "cli": "node cli.js",
    "add": "node cli.js add",
    "login": "node cli.js login",
    "list": "node cli.js list",
    "status": "node cli.js status",
    "logout": "node cli.js logout",
    "help": "node cli.js help"
  },
  "keywords": [
    "zalo",
    "zca-js",
    "multi-account",
    "bridge",
    "api",
    "messaging"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.18.2",
    "qrcode-terminal": "^0.12.0",
    "zca-js": "^2.1.2"
  },
  "engines": {
    "node": ">=18"
  }
}
